{
  "name": "ultima-zona",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test src/*.test.ts && node --test scripts/package.test.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test:browser": "node tests/browser.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "test:package": "node scripts/verify-package.mjs",
    "test:stability": "node tests/stability.mjs",
    "benchmark:queries": "tsx tests/benchmark-queries.ts",
    "build:mapa": "tsc --noEmit && vite build --mode mapa",
    "package:mapa": "npm run build:mapa && node scripts/package-map.mjs",
    "build:cartas": "tsc --noEmit && vite build --mode cartas",
    "package:cartas": "npm run build:cartas && node scripts/package-cards.mjs",
    "build:sertao": "tsc --noEmit && vite build --mode sertao",
    "package:sertao": "npm run build:sertao && node scripts/package-sertao.mjs",
    "test:sertao": "tsx tests/sertao-browser.ts",
    "test:sertao:dice": "tsx tests/sertao-dice.ts",
    "test:sertao:harvest": "tsx tests/sertao-harvest.ts",
    "test:sertao:pasture": "tsx tests/sertao-pasture.ts",
    "test:sertao:mining": "tsx tests/sertao-mining.ts",
    "test:sertao:clay": "tsx tests/sertao-clay.ts",
    "test:sertao:firewood": "tsx tests/sertao-firewood.ts",
    "test:sertao:menu": "tsx tests/sertao-menu.ts",
    "package:web": "npm run package:sertao && node scripts/package-web.mjs",
    "publish:web": "npm run package:web && node scripts/publish-web.mjs",
    "test:sertao:music": "tsx tests/sertao-menu-music.ts",
    "test:sertao:construction": "tsx tests/sertao-construction.ts",
    "test:sertao:random-board": "tsx tests/sertao-random-board.ts",
    "test:sertao:tropeiros": "tsx tests/sertao-tropeiros.ts",
    "test:sertao:options": "tsx tests/sertao-options.ts",
    "test:sertao:camera": "tsx tests/sertao-camera.ts",
    "test:sertao:game-music": "tsx tests/sertao-game-music.ts",
    "test:sertao:audio-assets": "tsx tests/sertao-audio-assets.ts",
    "test:sertao:player-trade": "tsx tests/sertao-player-trade.ts",
    "test:sertao:commerce": "tsx tests/sertao-commerce.ts",
    "test:sertao:trade-quantity": "tsx tests/sertao-trade-quantity.ts",
    "test:sertao:development": "tsx tests/sertao-development.ts",
    "test:sertao:sound": "tsx tests/sertao-sound.ts",
    "online:server": "tsx server/index.ts",
    "test:online": "tsx --test server/*.test.ts",
    "online:build": "tsc --noEmit -p tsconfig.online.json",
    "test:sertao:online": "tsx tests/sertao-online.ts"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.180.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
